# systemd unit for the Mac Mini (Linux).
# Install:
#   sudo cp rcm-linux-amd64 /usr/local/bin/rcm
#   sudo useradd --system --create-home --home-dir /var/lib/rcm rcm
#   sudo cp rcm.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now rcm
# Logs: journalctl -u rcm -f
[Unit]
Description=Rough Country Media server
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
User=rcm
Group=rcm
# Add one -lib per media folder (they are remembered, so you can also add them in Settings).
ExecStart=/usr/local/bin/rcm -addr :8080 -data /var/lib/rcm -import /srv/media/Imports -lib /srv/media
Restart=on-failure
RestartSec=5
# Be a good neighbor on an older machine.
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target
